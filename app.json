{
  "expo": {
    "name": "Navo",
    "slug": "navo",
    "scheme": "navo",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.tinybeex.navo"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.tinybeex.navo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#132B4F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#132B4F",
          "icon": "./assets/brand/notification.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Navo dùng camera để chụp danh thiếp, ảnh hiện trường và biên bản.",
          "photosPermission": "Navo mở thư viện ảnh để bạn chọn danh thiếp hoặc ảnh hiện trường."
        }
      ],
      "./plugins/with-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "tinybeex",
    "extra": {
      "eas": {
        "projectId": "61c1bad1-b896-41fe-ae7d-ac9b376cb014"
      }
    },
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/symbol.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
